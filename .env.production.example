# Plantilla para el despliegue de producción (docker/compose.prod.yml).
#
#   cp .env.production.example .env.production
#   # edita los valores marcados como CAMBIAR
#
# NUNCA se commitea .env.production real (ver .gitignore) — solo esta
# plantilla con valores de ejemplo.
# La infraestructura se lee exclusivamente del entorno del proceso. Cualquier
# OPENERP_<CAMPO> puede sustituirse por OPENERP_<CAMPO>_FILE=/run/secrets/...
# (el fichero gana a la variable directa). API, worker, migrate y bootstrap
# deben recibir el mismo fichero/secret y reiniciarse tras un cambio.
#
# Diferencia importante con el .env de desarrollo: dentro de Docker Compose
# los servicios se resuelven por nombre (por ejemplo, postgres), no por
# 127.0.0.1 — 127.0.0.1 dentro de un contenedor es el propio contenedor.

# --- credenciales de PostgreSQL (leídas por el servicio `postgres`) ---
POSTGRES_USER=openerp
POSTGRES_PASSWORD=CAMBIAR-a-una-contraseña-larga-y-aleatoria
POSTGRES_DB=openerp

# --- aplicación ---
OPENERP_APP_NAME=OpenERP
OPENERP_ENVIRONMENT=production
OPENERP_DEBUG=false

# --- base de datos (mismo usuario/contraseña/db que arriba; host = nombre
# del servicio de Compose, no 127.0.0.1) ---
OPENERP_DATABASE_URL=postgresql://openerp:CAMBIAR-a-una-contraseña-larga-y-aleatoria@postgres:5432/openerp
# OPENERP_DATABASE_URL_FILE=/run/secrets/openerp_database_url
# Los scripts host-side también respetan *_FILE. Si la ruta anterior sólo
# existe dentro del contenedor, exporta OPENERP_BACKUP_SOURCE_URL_FILE o
# OPENERP_RESTORE_SERVER_URL_FILE con una ruta legible por el host. Nunca pases
# una URL con contraseña como argumento de línea de comandos.
OPENERP_DB_POOL_SIZE=10
OPENERP_DB_MAX_OVERFLOW=20
OPENERP_DB_POOL_PRE_PING=true
OPENERP_DB_STATEMENT_TIMEOUT_MS=30000
OPENERP_DB_ECHO=false

# Retención local conservadora; el backup recién creado nunca se elimina.
OPENERP_BACKUP_KEEP_COUNT=14

# --- logging ---
OPENERP_LOG_LEVEL=INFO
OPENERP_LOG_FORMAT=json

# --- http ---
# Producción sirve SPA y API desde el mismo origen: CORS queda deshabilitado.
# Desarrollo conserva http://localhost:5173 por defecto.
OPENERP_CORS_ORIGINS=
# Red Docker exclusiva del stack. Nginx recibe una IP fija dentro de ella y
# es el único peer cuyos X-Forwarded-* acepta Uvicorn. Ajusta ambas direcciones
# juntas si 172.30.0.0/24 colisiona con otra red del host.
OPENERP_BACKEND_SUBNET=172.30.0.0/24
OPENERP_TRUSTED_PROXY_IP=172.30.0.10

# --- auth / sesiones ---
OPENERP_SESSION_COOKIE_NAME=openerp_session
OPENERP_SESSION_TTL_DAYS=30
OPENERP_SESSION_TOUCH_INTERVAL_SECONDS=60
# Con estas dos variables puestas, `make prod-bootstrap-admin` crea el
# primer administrador sin preguntar nada por terminal (ver
# docs/ADMIN_GUIDE.md) — cómodo para un despliegue repetible, pero es una
# contraseña conocida por cualquiera que lea este fichero. Cámbiala aquí
# antes del primer despliegue, y otra vez desde dentro del panel
# («Mi cuenta» en /admin) en cuanto entres la primera vez.
OPENERP_BOOTSTRAP_ADMIN_EMAIL=admin@tuempresa.example
OPENERP_BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR-CambiaEstaClave-2026
# OPENERP_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/openerp_bootstrap_password

# --- SMTP / outbox ---
# Mailpit queda exclusivamente en docker/compose.yml de desarrollo. Producción
# debe apuntar a un relay corporativo si se habilitan destinatarios.
OPENERP_SMTP_HOST=CAMBIAR-smtp.tuempresa.local
OPENERP_SMTP_PORT=587
OPENERP_SMTP_USE_TLS=true
# OPENERP_SMTP_USERNAME=
# OPENERP_SMTP_PASSWORD=
# OPENERP_SMTP_PASSWORD_FILE=/run/secrets/openerp_smtp_password
OPENERP_SMTP_FROM_EMAIL=no-reply@openerp.tuempresa.local
# Quién recibe el aviso cuando se abre una incidencia nueva (fase 17).
# Vacío = no se encola correo; las incidencias se siguen viendo en /incidents.
# OPENERP_NOTIFICATION_RECIPIENT_EMAIL=

# --- QZ Tray: firma silenciosa de trabajos de impresión (opcional) ---
# Host/puerto/nombre de impresora se configuran desde Terminales POS. Aquí
# sólo van el certificado público y la clave privada que firma cada llamada
# protegida. Copia ambos a deploy/qz-signing/ (ignorado por Git), usa chmod
# 640 y pon aquí el GID del usuario del host que despliega (`id -g`).
OPENERP_HOST_SECRET_GID=1000
# OPENERP_QZ_SIGNING_CERTIFICATE_FILE=/run/secrets/qz-signing/digital-certificate.txt
# OPENERP_QZ_SIGNING_PRIVATE_KEY_FILE=/run/secrets/qz-signing/private-key.pem

# --- seguridad ---
OPENERP_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
OPENERP_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
OPENERP_LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=20
OPENERP_LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=300
