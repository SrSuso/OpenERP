# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# --- node ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- playwright / local run artefacts ---
.artifacts/
tests/e2e/.artifacts/
playwright-report/
test-results/

# --- local config & data ---
.env
.env.local
*.local
.env.production

# --- production TLS material (phase: production deployment) ---
# Never commit private keys. scripts/gen-internal-cert.sh writes here.
/deploy/certs/*
!/deploy/certs/.gitkeep
# QZ's private signing key is a deployment secret, never source code.
/deploy/qz-signing/*
!/deploy/qz-signing/.gitkeep
/deploy/maintenance/enabled
/deploy/state/

# --- database backups (phase 21) ---
/backups/
*.dump

# --- editors / os ---
.idea/
.vscode/
!.vscode/extensions.json
.DS_Store
