# Copy to .env and adjust. Infrastructure is process configuration: API,
# worker, Alembic, bootstrap and operational scripts all read the same
# OPENERP_* model. It is never overridden by the PostgreSQL settings table.
#
# Any field can alternatively be supplied as OPENERP_<FIELD>_FILE pointing to
# a mounted secret file. Precedence is *_FILE, direct variable, .env, default.
# Changes take effect after restarting every component that consumes them.
#
# Docker Compose (docker/compose.yml) publishes PostgreSQL on 5432.
# The rootless script (scripts/dev-postgres.sh) uses 55432 to avoid clashing
# with a system PostgreSQL.

# --- application ---
OPENERP_APP_NAME=OpenERP
OPENERP_ENVIRONMENT=local
OPENERP_DEBUG=false

# --- database ---
OPENERP_DATABASE_URL=postgresql://openerp:openerp@127.0.0.1:5432/openerp
# OPENERP_DATABASE_URL_FILE=/run/secrets/openerp_database_url
OPENERP_DB_POOL_SIZE=5
OPENERP_DB_MAX_OVERFLOW=10
OPENERP_DB_POOL_PRE_PING=true
OPENERP_DB_STATEMENT_TIMEOUT_MS=30000
OPENERP_DB_ECHO=false

# --- logging ---
OPENERP_LOG_LEVEL=INFO
# json in production, console while developing
OPENERP_LOG_FORMAT=console

# --- http ---
OPENERP_CORS_ORIGINS=http://localhost:5173

# --- auth / sessions ---
OPENERP_SESSION_COOKIE_NAME=openerp_session
OPENERP_SESSION_TTL_DAYS=30
OPENERP_SESSION_TOUCH_INTERVAL_SECONDS=60
# Uncomment to create the first admin non-interactively (see
# `uv run python -m app.auth.bootstrap`). Leave unset to be prompted instead;
# never commit real values here.
# OPENERP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# OPENERP_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
# OPENERP_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/openerp_bootstrap_password

# --- SMTP / outbox (phase 18) ---
# Defaults match Mailpit (docker/compose.yml or scripts/dev-mailpit.sh).
OPENERP_SMTP_HOST=127.0.0.1
OPENERP_SMTP_PORT=1025
OPENERP_SMTP_USE_TLS=false
# OPENERP_SMTP_USERNAME=
# OPENERP_SMTP_PASSWORD=
# OPENERP_SMTP_PASSWORD_FILE=/run/secrets/openerp_smtp_password
OPENERP_SMTP_FROM_EMAIL=no-reply@openerp.local
# Unset = queue nothing; incidents (phase 17) still work via GET /incidents.
# OPENERP_NOTIFICATION_RECIPIENT_EMAIL=ops@example.com

# --- security (phase 19) ---
# POST /auth/login rate limiting: tight per-email limit, looser per-IP limit
# (a store's till terminals typically share one public IP — see
# app.auth.service's own docstring on the split).
OPENERP_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
OPENERP_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
OPENERP_LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=20
OPENERP_LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=300

# --- tests ---
# Server used by pytest to create throwaway databases.  Leave unset to have
# Testcontainers start one, which requires a working Docker daemon.
OPENERP_TEST_DATABASE_URL=postgresql://openerp:openerp@127.0.0.1:5432/postgres

# --- frontend (frontend/.env.local) ---
# VITE_API_BASE_URL=            # empty = same origin, dev proxies /api
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
