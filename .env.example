# Copy to .env and adjust.  Everything the backend reads is prefixed OPENERP_.
#
# Docker Compose (docker/compose.yml) publishes PostgreSQL on 5432.
# The rootless script (scripts/dev-postgres.sh) uses 55432 to avoid clashing
# with a system PostgreSQL.

# --- application ---
OPENERP_APP_NAME=OpenERP
OPENERP_ENVIRONMENT=local
OPENERP_DEBUG=false

# --- database ---
OPENERP_DATABASE_URL=postgresql://openerp:openerp@127.0.0.1:5432/openerp
OPENERP_DB_POOL_SIZE=5
OPENERP_DB_MAX_OVERFLOW=10
OPENERP_DB_STATEMENT_TIMEOUT_MS=30000
OPENERP_DB_ECHO=false

# --- logging ---
OPENERP_LOG_LEVEL=INFO
# json in production, console while developing
OPENERP_LOG_FORMAT=console

# --- http ---
OPENERP_CORS_ORIGINS=http://localhost:5173

# --- tests ---
# Server used by pytest to create throwaway databases.  Leave unset to have
# Testcontainers start one, which requires a working Docker daemon.
OPENERP_TEST_DATABASE_URL=postgresql://openerp:openerp@127.0.0.1:5432/postgres

# --- frontend (frontend/.env.local) ---
# VITE_API_BASE_URL=            # empty = same origin, dev proxies /api
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
